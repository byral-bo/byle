@link "c"
extern fn by_log_debug(ptr)
extern fn by_log_info(ptr)
extern fn by_log_warn(ptr)
extern fn by_log_error(ptr)
extern fn by_log_set_level(i32)
extern fn by_log_set_output(ptr) i32
extern fn by_log_set_console()

LOG_DEBUG := 0
LOG_INFO  := 1
LOG_WARN  := 2
LOG_ERROR := 3

final class Log:
    static fn debug(msg: &str):
        by_log_debug(msg as ptr)

    static fn info(msg: &str):
        by_log_info(msg as ptr)

    static fn warn(msg: &str):
        by_log_warn(msg as ptr)

    static fn error(msg: &str):
        by_log_error(msg as ptr)

    static fn set_level(level: i32):
        by_log_set_level(level)

    static fn set_output(path: &str) i32:
        by_log_set_output(path as ptr)

    static fn set_console():
        by_log_set_console()
